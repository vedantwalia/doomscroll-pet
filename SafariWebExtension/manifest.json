{
  "manifest_version": 3,
  "name": "Doomscroll Pet \u2014 Safari",
  "version": "0.4.1",
  "description": "A desktop cat visits near your chosen time limit on selected websites.",
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Doomscroll Pet",
    "default_popup": "popup.html",
    "default_icon": "images/toolbar-icon.svg"
  }
}
